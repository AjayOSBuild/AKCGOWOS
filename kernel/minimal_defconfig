# OS Project Minimal Linux Kernel Configuration
# Optimized for QEMU (VirtIO) and UEFI Boot

# 64-bit Architecture
CONFIG_64BIT=y
CONFIG_X86_64=y

# Boot & EFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RELOCATABLE=y

# Serial & Debugging (for QEMU headless testing)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_EARLY_PRINTK_EFI=y
CONFIG_MAGIC_SYSRQ=y

# Virtualization (QEMU / KVM)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Core OS Features (IPC, Memory, Process Management)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_SMP=y

# Executable Formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Block Devices & RAM disk (for initramfs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y

# Advanced Logging & Crash Dumps (KERN-003)
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_CRASH_DUMP=y
CONFIG_PROC_VMCORE=y
CONFIG_DEBUG_FS=y
CONFIG_PRINTK_CALLER=y

# Threading & Concurrency Primitives (KERN-005)
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_AIO=y
CONFIG_SCHED_INFO=y

# Scheduler Configuration & Desktop Responsiveness (KERN-006)
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_AUTOGROUP=y

# Timer Subsystem & Power Management (KERN-007)
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CPUSETS=y
CONFIG_CPU_IDLE=y

# Virtual Memory & Allocation Optimizations (KERN-008)
CONFIG_MMU=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_COMPACTION=y
CONFIG_KSM=y
CONFIG_SWAP=y
CONFIG_ZSWAP=y

# Memory Allocation (SLUB) & Debugging (KERN-009)
CONFIG_SLUB=y
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y
CONFIG_PAGE_POISONING=y
CONFIG_DEBUG_MEMORY_INIT=y

# System Call Interface & Compatibility (KERN-010)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_IA32_EMULATION=y
CONFIG_COMPAT_32=y
CONFIG_X86_X32_ABI=y

# Inter-Process Communication (KERN-011)
CONFIG_UNIX=y
CONFIG_UNIX_SCM=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Signals & Event Notification Primitives (KERN-012)
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# Synchronization Primitives & Preemptive RCU (KERN-013)
CONFIG_PREEMPT_RCU=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
CONFIG_MUTEX_SPIN_ON_OWNER=y
CONFIG_RWSEM_SPIN_ON_OWNER=y

# Device Model & Firmware Loading (KERN-014)
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UEVENT_HELPER=y
CONFIG_FW_LOADER=y

# Kernel Diagnostics & Tracing (KERN-015)
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# Kernel Test Framework (KERN-016)
CONFIG_KUNIT=y
CONFIG_KUNIT_DEBUGFS=y

# Kernel Panic Diagnostics & KGDB (KERN-017)
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
CONFIG_MAGIC_SYSRQ_SERIAL=y

# Crash Logging (Kdump & Pstore) (KERN-018)
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Performance Measurement & Profiling (KERN-019)
CONFIG_PROFILING=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_UPROBES=y
CONFIG_KPROBES=y

# Phase 3: Hardware Support
# PCI & PCIe Bus Detection (HW-001)
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_PCIEAER=y

# USB Core & Host Controllers (HW-002)
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y

# USB Device Enumeration & Monitoring (HW-003)
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_DEFAULT_PERSIST=y
CONFIG_USB_MON=y

# Input Subsystem & Keyboard Support (HW-004)
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Mouse & Pointer Input Support (HW-005)
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_TABLET=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_HID_MULTITOUCH=y

# Storage Block Layer & SCSI Core (HW-006)
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# NVMe Storage Support (HW-007)
CONFIG_BLK_DEV_NVME=y

# SATA / AHCI Storage Support (HW-008)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y

# Core Networking & Ethernet Support (HW-009)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y

# Wireless Networking (Wi-Fi) (HW-010)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y

# Bluetooth Subsystem (HW-011)
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y

# Advanced Linux Sound Architecture (Audio) (HW-012)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y

# Direct Rendering Manager & GPU Display (HW-013)
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_I915=y
CONFIG_DRM_NOUVEAU=y

# Advanced Configuration and Power Interface (ACPI) (HW-014)
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_PROCESSOR=y
